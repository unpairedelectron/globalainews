{
  "name": "@workspace/global-ai-news",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build:staging && vite --config vite.config.ts --host 0.0.0.0",
    "build": "pnpm run build:staging && vite build --config vite.config.ts",
    "build:release": "pnpm run build:staging && node ../../scripts/build-global-ai-news-release.mjs",
    "build:server": "vite build --config vite.server.config.ts",
    "build:production": "pnpm run build:release && pnpm run build:server",
    "build:staging": "node ../../scripts/build-article-registry.mjs && node scripts/build-staging-articles.mjs",
    "images:optimize": "node scripts/optimize-editorial-images.mjs",
    "serve": "node --enable-source-maps dist/server/server.mjs",
    "verify:live": "node scripts/verify-live-article.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:published-evidence": "pnpm exec tsx scripts/audit-published-evidence.ts",
    "audit:preview": "pnpm run build:production && node scripts/audit-preview-regressions.mjs",
    "release:manifest": "node ../../scripts/build-publication-state-manifest.mjs",
    "release:editorial-manifest": "node ../../scripts/build-release-manifest.mjs",
    "test:article-registry": "node --test tests/article-registry.test.mjs",
    "test:staging-articles": "node --test tests/staging-articles.test.mjs",
    "test:release-manifest": "pnpm run release:editorial-manifest && pnpm exec tsx --test tests/release-manifest.test.ts",
    "test:publication-state-manifest": "pnpm run release:manifest && pnpm exec tsx --test tests/publication-state-manifest.test.ts",
    "typecheck": "pnpm --filter @workspace/api-client-react exec tsc --build && tsc -p tsconfig.json --noEmit",
    "test:release-metadata": "node tests/release-metadata.test.mjs",
    "test:ads": "pnpm exec tsx --test tests/ads-activation.test.ts && node tests/ads-config.test.mjs",
    "test:release-history": "node tests/release-history.test.mjs",
    "test:theme": "node tests/theme.test.mjs",
    "test:analytics-privacy": "pnpm exec tsx --test tests/analytics-privacy.test.ts",
    "test:content-quality": "pnpm exec tsx --test tests/content-quality.test.mjs",
    "test:research-report": "pnpm exec tsx --test tests/research-report.test.mjs",
    "test:authority-registry": "pnpm exec tsx --test tests/authority-registry.test.ts",
    "test:70-article-fixture": "pnpm exec tsx --test tests/disposable-70-article-validation.test.ts",
    "test:publication-fixture": "pnpm exec tsx --test tests/publication-flow-fixture.test.ts",
    "test:seo-date-stability": "pnpm exec tsx --test tests/seo-date-stability.test.mjs",
    "test:article-first-response": "node tests/article-first-response.test.mjs",
    "test:article-snapshot-resilience": "pnpm exec tsx --test tests/article-snapshot-resilience.test.ts",
    "test:code-native-publication": "pnpm exec tsx --test tests/code-native-publication.test.ts",
    "test:operational-alerts": "pnpm exec tsx --test tests/operational-alerts.test.ts",
    "test:published-evidence-audit": "pnpm exec tsx --test tests/published-evidence-audit.test.ts",
    "test:web-health": "node --test tests/web-health.test.mjs",
    "test:visual": "node --test --test-name-pattern=\"light and dark themes stay readable across key public and newsroom routes\" tests/seo-smoke.test.mjs",
    "update:visual-baselines": "UPDATE_VISUAL_BASELINES=1 pnpm run test:visual",
    "test:publication-safety": "pnpm exec tsx --test tests/publication-safety.test.ts",
    "test:smoke": "pnpm --filter @workspace/api-server run build && pnpm --filter @workspace/api-server run test:public-newsroom-cache && pnpm --filter @workspace/api-server run test:comparison-reviews && pnpm run test:publication-safety && pnpm --filter @workspace/api-server run test:security && pnpm --filter @workspace/api-server run test:gzip && pnpm run test:release-metadata && pnpm run test:release-history && pnpm run test:theme && pnpm run test:analytics-privacy && pnpm run test:content-quality && pnpm run test:staging-articles && pnpm run test:research-report && pnpm run test:authority-registry && pnpm run test:seo-date-stability && pnpm run build:production && pnpm run test:web-health && pnpm run test:ads && pnpm run test:publication-fixture && pnpm run test:article-first-response && pnpm run test:code-native-publication && pnpm run test:article-snapshot-resilience && pnpm run test:operational-alerts && pnpm run audit:links && node --test tests/seo-smoke.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@replit/vite-plugin-cartographer": "catalog:",
    "@replit/vite-plugin-dev-banner": "catalog:",
    "@replit/vite-plugin-runtime-error-modal": "catalog:",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@workspace/api-client-react": "workspace:*",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "catalog:",
    "input-otp": "^1.4.2",
    "lighthouse": "^13.6.0",
    "lucide-react": "catalog:",
    "next-themes": "^0.4.6",
    "playwright-core": "^1.64.1",
    "react": "catalog:",
    "react-day-picker": "^9.11.1",
    "react-dom": "catalog:",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite": "catalog:",
    "wouter": "^3.3.5",
    "zod": "catalog:"
  },
  "dependencies": {
    "@clerk/react": "^6.16.1",
    "@clerk/themes": "^2.4.57",
    "express": "^5.2.1",
    "markdown-it": "^15.0.3"
  }
}
