{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Global AI News Intelligence System",
  "description": "A calm, authoritative editorial system for AI economy intelligence.",
  "color": {
    "light": {
      "background": { "$value": "#f6f4ef", "$type": "color" },
      "foreground": { "$value": "#11161a", "$type": "color" },
      "surface": { "$value": "#ffffff", "$type": "color" },
      "surfaceMuted": { "$value": "#ebe9e3", "$type": "color" },
      "rule": { "$value": "#c8c6bf", "$type": "color" },
      "primary": { "$value": "#1557d6", "$type": "color" },
      "primaryForeground": { "$value": "#ffffff", "$type": "color" },
      "secondary": { "$value": "#e4e8ef", "$type": "color" },
      "secondaryForeground": { "$value": "#172232", "$type": "color" },
      "muted": { "$value": "#e9e8e2", "$type": "color" },
      "mutedForeground": { "$value": "#5b6064", "$type": "color" },
      "accent": { "$value": "#e6b84b", "$type": "color" },
      "accentForeground": { "$value": "#11161a", "$type": "color" },
      "success": { "$value": "#286a53", "$type": "color" },
      "warning": { "$value": "#a05e22", "$type": "color" },
      "danger": { "$value": "#a23d38", "$type": "color" }
    },
    "dark": {
      "background": { "$value": "#11161a", "$type": "color" },
      "foreground": { "$value": "#f1efe9", "$type": "color" },
      "surface": { "$value": "#1a2126", "$type": "color" },
      "surfaceMuted": { "$value": "#252d33", "$type": "color" },
      "rule": { "$value": "#485058", "$type": "color" },
      "primary": { "$value": "#79a6ff", "$type": "color" },
      "primaryForeground": { "$value": "#0d1522", "$type": "color" },
      "secondary": { "$value": "#27313a", "$type": "color" },
      "secondaryForeground": { "$value": "#f1efe9", "$type": "color" },
      "muted": { "$value": "#273039", "$type": "color" },
      "mutedForeground": { "$value": "#b3bbc0", "$type": "color" },
      "accent": { "$value": "#e6bd58", "$type": "color" },
      "accentForeground": { "$value": "#101418", "$type": "color" },
      "success": { "$value": "#75c6a1", "$type": "color" },
      "warning": { "$value": "#efb46f", "$type": "color" },
      "danger": { "$value": "#ee8d87", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "serif": { "$value": "Instrument Serif, Georgia, serif", "$type": "fontFamily" },
      "sans": { "$value": "DM Sans, Arial, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "DM Mono, SFMono-Regular, monospace", "$type": "fontFamily" }
    },
    "display": { "$value": "clamp(3.25rem, 9vw, 8.75rem)", "$type": "dimension" },
    "headline": { "$value": "clamp(2.4rem, 5vw, 5.6rem)", "$type": "dimension" },
    "body": { "$value": "1rem", "$type": "dimension" },
    "small": { "$value": "0.78rem", "$type": "dimension" }
  },
  "radius": {
    "base": { "$value": "0.15rem", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "spacing": {
    "base": { "$value": "0.25rem", "$type": "dimension" },
    "container": { "$value": "1440px", "$type": "dimension" },
    "gutter": { "$value": "clamp(1.25rem, 3vw, 3.5rem)", "$type": "dimension" }
  }
}