{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=\"${NODE_ENV:-development}\" && export NEWSROOM_ALLOW_DEFAULT_SCHEDULE_SEED=\"${NEWSROOM_ALLOW_DEFAULT_SCHEDULE_SEED:-true}\" && pnpm run build && pnpm run start",
    "prebuild": "node ../../scripts/build-article-registry.mjs && node ../../scripts/build-release-manifest.mjs && node ../../scripts/build-release-discovery.mjs",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:automation": "node --experimental-strip-types --test tests/automation-contract.test.ts",
    "test:comparison-reviews": "node --experimental-strip-types --test tests/comparison-source-reviews.test.ts",
    "test:public-newsroom-cache": "node --experimental-strip-types --test tests/public-newsroom-cache.test.ts",
    "test:publication-registry": "node --experimental-strip-types --test tests/publication-registry-visibility.test.ts",
    "test:publication-surfaces": "node --test tests/publication-surface-wiring.test.mjs",
    "test:release-discovery": "node --experimental-strip-types --test tests/release-discovery-visibility.test.ts",
    "test:publication-admin": "node --experimental-strip-types --test tests/publication-admin-logic.test.ts && node --test tests/publication-admin-wiring.test.mjs",
    "test:gzip": "node --experimental-strip-types --test tests/gzip-response.test.mjs",
    "test:security": "node --test tests/braces-depth-security.test.mjs tests/clerk-proxy.test.mjs tests/editor-auth.test.mjs",
    "replay:automation": "pnpm run build && node ./dist/editorial/replay-command.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.69",
    "@clerk/shared": "^4.33.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "httpxy": "0.5.5",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
