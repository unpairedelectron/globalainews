---
import Base from '../layouts/Base.astro';
---
<Base title="You’re offline | Global AI News" description="You’re offline. Articles you have opened before are still available on this device." path="/offline/" noindex ads={false}>
  <div class="wrap">
    <article class="page">
      <h1>You’re offline</h1>
      <p class="dek">No connection right now. Articles you’ve opened before on this device are still available. Go back and pick one, or try again when you’re back online.</p>
      <p><a class="btn" href="/">Try the home page again</a></p>
    </article>
  </div>
</Base>
