---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { SITE, CATEGORIES } from '../../site.config';
import { getArticles } from '../../lib/articles';
const cat = CATEGORIES.guides;
const items = (await getArticles()).filter((a) => a.data.category === 'guides');
---
<Base title={`${cat.title} | ${SITE.name}`} description={cat.description} path={cat.path}>
  <div class="wrap">
    <header class="page-head">
      <h1>{cat.name}</h1>
      <p>{cat.description} We do not rank products by answer quality; we compare what each vendor documents, under which plan, and with which limits.</p>
    </header>
    <ArticleList articles={items} showCategory={false} />
  </div>
</Base>
