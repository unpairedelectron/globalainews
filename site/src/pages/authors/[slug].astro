---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { SITE } from '../../site.config';
import { PEOPLE, type Person } from '../../data/people';
import { getArticles, absolute } from '../../lib/articles';

export function getStaticPaths() {
  return Object.values(PEOPLE).map((p) => ({ params: { slug: p.slug }, props: { person: p } }));
}
const { person } = Astro.props as { person: Person };
const all = await getArticles();
const written = all.filter((a) => a.data.author === person.slug);
const reviewed = all.filter((a) => a.data.reviewer?.toLowerCase() === person.name.toLowerCase() && a.data.author !== person.slug);
const url = absolute(`/authors/${person.slug}/`);
const jsonLd = [{
  '@type': 'ProfilePage',
  url,
  mainEntity: {
    '@type': 'Person',
    '@id': `${url}#person`,
    name: person.name,
    jobTitle: person.jobTitle,
    description: person.bio[0],
    homeLocation: { '@type': 'Place', name: person.location },
    worksFor: { '@id': `${SITE.url}/#organization` },
    url,
    ...(person.image ? { image: absolute(person.image) } : {}),
    ...(person.sameAs?.length ? { sameAs: person.sameAs } : {}),
  },
}, {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Our team', item: absolute('/authors/') },
    { '@type': 'ListItem', position: 3, name: person.name, item: url },
  ],
}];
---
<Base title={`${person.name}, ${person.jobTitle} | ${SITE.name}`} description={`${person.name} is ${person.jobTitle} of ${SITE.name}, based in ${person.location}. Role, responsibilities and the articles ${person.name.split(' ')[0]} has written or reviewed.`} path={`/authors/${person.slug}/`} jsonLd={jsonLd}>
  <div class="wrap">
    <article class="page">
      <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/authors/">Our team</a></li></ol></nav>
      <h1>{person.name}</h1>
      <p class="meta">{person.jobTitle} · {person.location}</p>
      <div class="prose">
        {person.bio.map((p) => <p>{p}</p>)}
        <h2>Responsibilities</h2>
        <ul>{person.responsibilities.map((r) => <li>{r}</li>)}</ul>
        {person.sameAs?.length ? <p>Elsewhere: {person.sameAs.map((u, i) => <>{i > 0 && ' · '}<a href={u} rel="me noopener">{new URL(u).hostname.replace('www.', '')}</a></>)}</p> : null}
        <p>Feedback or corrections: see our <a href="/contact-us/">contact page</a>.</p>
      </div>
      {written.length > 0 && <section class="section"><h2>Articles by {person.name}</h2><ArticleList articles={written} /></section>}
      {reviewed.length > 0 && <section class="section"><h2>Articles reviewed by {person.name}</h2><ArticleList articles={reviewed} /></section>}
    </article>
  </div>
</Base>
