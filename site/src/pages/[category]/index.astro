---
import Base from '../../layouts/Base.astro';
import CategoryHub from '../../components/CategoryHub.astro';
import { SITE, CATEGORIES, type CategoryKey } from '../../site.config';
import { getArticles, absolute, articlePath } from '../../lib/articles';

export async function getStaticPaths() {
  return (Object.keys(CATEGORIES) as CategoryKey[])
    .filter((k) => k !== 'guides')
    .map((key) => ({ params: { category: CATEGORIES[key].path.replaceAll('/', '') }, props: { key } }));
}
const { key } = Astro.props as { key: CategoryKey };
const cat = CATEGORIES[key];
const items = (await getArticles()).filter((a) => a.data.category === key);
const jsonLd = [{
  '@type': 'CollectionPage', name: cat.title, url: absolute(cat.path), description: cat.description,
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: { '@type': 'ItemList', itemListElement: items.slice(0, 20).map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: absolute(articlePath(a)), name: a.data.title })) },
}];
---
<Base title={`${cat.title} | ${SITE.name}`} description={cat.description} path={cat.path} jsonLd={jsonLd} feed={{ title: `${SITE.name}: ${cat.name}`, href: `${cat.path}feed.xml` }}>
  <div class="wrap"><CategoryHub categoryKey={key} items={items} /></div>
</Base>
