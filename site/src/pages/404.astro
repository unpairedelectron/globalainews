---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import { getArticles } from '../lib/articles';
const latest = (await getArticles()).slice(0, 5);
---
<Base title="Page not found | Global AI News" description="The page you were looking for could not be found." path="/404/" noindex ads={false}>
  <div class="wrap">
    <header class="page-head">
      <h1>Page not found</h1>
      <p>The page may have moved or no longer exists. Try one of our latest stories, or go to the <a href="/">home page</a>.</p>
    </header>
    <ArticleList articles={latest} />
  </div>
</Base>
