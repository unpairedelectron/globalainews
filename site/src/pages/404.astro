---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import { CATEGORIES } from '../site.config';
import { getArticles } from '../lib/articles';
const latest = (await getArticles()).slice(0, 5);
---
<Base title="Page not found | Global AI News" description="The page you were looking for could not be found." path="/404/" noindex ads={false}>
  <div class="wrap">
    <header class="page-head nf">
      <span class="eyebrow">Error 404</span>
      <h1>This page isn’t on our map</h1>
      <p>It may have moved, or the link may be mistyped. Search the site, or pick up from one of these.</p>
      <div class="hero-actions" style="margin-top:18px">
        <button class="btn" type="button" data-search-open>Search Global AI News</button>
        <a class="btn ghost" href="/">Home page</a>
      </div>
      <div class="chips" style="margin-top:18px">
        <a class="chip" href="/latest/">Latest stories</a>
        {Object.values(CATEGORIES).slice(0, 4).map((c) => <a class="chip" href={c.path}>{c.name}</a>)}
        <a class="chip" href="/trackers/">Trackers</a>
        <a class="chip" href="/glossary/">AI glossary</a>
      </div>
    </header>
    <section class="section" aria-labelledby="nf-latest">
      <div class="section-head"><h2 id="nf-latest">Latest stories</h2></div>
      <ArticleList articles={latest} />
    </section>
  </div>
</Base>

<style>
  .nf .btn { border: 0; cursor: pointer; font-family: inherit; }
</style>
