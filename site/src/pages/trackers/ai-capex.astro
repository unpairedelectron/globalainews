---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config';
import { CAPEX_TRACKER } from '../../data/trackers';
import { getArticles, articlePath, absolute } from '../../lib/articles';
const explainer = (await getArticles()).find((a) => a.id === 'hyperscaler-capex-2026-reconciled');
const lastChecked = CAPEX_TRACKER.map((r) => r.checked).sort().at(-1)!;
const fmt = (s: string) => new Date(`${s}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const jsonLd = [{
  '@type': 'Dataset',
  name: 'Big Tech AI Capex Tracker 2026',
  description: '2026 capital-expenditure guidance from Alphabet, Amazon, Meta and Microsoft, with the accounting basis of each figure and links to company filings and calls.',
  url: absolute('/trackers/ai-capex/'),
  creator: { '@id': `${SITE.url}/#organization` },
  dateModified: lastChecked,
  isAccessibleForFree: true,
  citation: CAPEX_TRACKER.map((r) => r.source.url),
}];
---
<Base title="Big Tech AI Capex Tracker 2026: Meta, Google, Microsoft, Amazon" description="2026 capital-spending guidance from Alphabet, Amazon, Meta and Microsoft side by side, with the accounting basis of each figure and links to the earnings releases and calls." path="/trackers/ai-capex/" jsonLd={jsonLd}>
  <div class="wrap">
    <article class="page tracker" style="max-width:1080px">
      <nav class="crumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li><a href="/trackers/">Trackers</a></li></ol></nav>
      <h1>Big Tech AI capex tracker</h1>
      <p class="dek">What Alphabet, Amazon, Meta and Microsoft say they will spend on capital projects in 2026, on each company’s own basis, with links to the source.</p>
      <p class="meta">Last checked: {fmt(lastChecked)} · Maintained by the {SITE.desk} · <a href="/contact-us/">Report an update</a></p>
      <div class="prose"><table>
        <thead><tr><th>Company</th><th>2026 guidance</th><th>What the figure includes</th><th>Latest quarter</th><th>Source</th></tr></thead>
        <tbody>{CAPEX_TRACKER.map((r) => (
          <tr><td><strong>{r.company}</strong></td><td>{r.guidance}</td><td>{r.basis}</td><td>{r.latestQuarter}</td><td><a href={r.source.url} rel="noopener">{r.source.label}</a><br /><span class="meta">Checked {fmt(r.checked)}</span></td></tr>
        ))}</tbody>
      </table></div>
      <h2>Why there is no total</h2>
      <p>The four figures use different periods (Microsoft’s fiscal year ends in June), different accounting bases (Meta includes finance-lease principal; Amazon reports cash capex) and broad categories that are not AI-only. Adding them would produce a precise-looking number that measures nothing consistent.{explainer && <> Read the full analysis: <a href={articlePath(explainer)}>{explainer.data.title}</a>.</>}</p>
      <p class="meta">Company guidance is forward-looking and can change. This is not investment advice.</p>
    </article>
  </div>
</Base>
