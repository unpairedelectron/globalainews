---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleList from '../components/ArticleList.astro';
import { SITE, CATEGORIES, type CategoryKey } from '../site.config';
import { getArticles, articlePath, category, formatDate, readingTime } from '../lib/articles';

const all = await getArticles();
const news = all.filter((a) => a.data.type === 'article');
const [lead, ...rest] = news;
const top = rest.slice(0, 6);
const shown = new Set([lead, ...top].map((a) => a.id));
const sections: CategoryKey[] = ['india', 'policy', 'models', 'guides'];
const jsonLd = [
  { '@type': 'WebSite', '@id': `${SITE.url}/#website`, name: SITE.name, url: `${SITE.url}/`, description: SITE.description, inLanguage: SITE.lang, publisher: { '@id': `${SITE.url}/#organization` } },
];
---
<Base title={`${SITE.name} – AI News, Analysis and Explainers`} description={SITE.description} path="/" jsonLd={jsonLd}>
  <div class="wrap">
    <h1 class="skip">{SITE.name}: AI news, analysis and explainers</h1>
    {lead && (
      <section class="lead" aria-label="Top story">
        <div>
          <a class="kicker" href={category(lead).path}>{category(lead).name}</a>
          <h2><a href={articlePath(lead)}>{lead.data.title}</a></h2>
          <p>{lead.data.description}</p>
          <p class="meta"><time datetime={lead.data.date.toISOString()}>{formatDate(lead.data.date)}</time> · {readingTime(lead)} min read</p>
        </div>
        {lead.data.image && <a href={articlePath(lead)} tabindex="-1" aria-hidden="true"><img class="card-img" src={lead.data.image} alt="" width="1200" height="675" fetchpriority="high" /></a>}
      </section>
    )}

    <section class="section" aria-labelledby="latest-h">
      <div class="section-head"><h2 id="latest-h">Latest</h2><a href="/latest/">All stories →</a></div>
      <div class="grid grid-3">{top.map((a, i) => <ArticleCard article={a} eager={i < 3} />)}</div>
    </section>

    <section class="section" aria-labelledby="gloss-h">
      <div class="section-head"><h2 id="gloss-h">New to AI? Start with the basics</h2><a href="/glossary/">AI glossary →</a></div>
      <p style="margin:0;color:var(--muted);max-width:760px">Plain-English definitions of the terms behind the headlines: <a href="/glossary/#ai-agent">AI agent</a>, <a href="/glossary/#token">token</a>, <a href="/glossary/#rag">RAG</a>, <a href="/glossary/#hallucination">hallucination</a>, <a href="/glossary/#open-weights">open weights</a>, <a href="/glossary/#mcp">MCP</a> and more.</p>
    </section>

    {sections.map((key) => {
      const items = all.filter((a) => a.data.category === key && !shown.has(a.id)).slice(0, 4);
      return items.length > 0 && (
        <section class="section" aria-labelledby={`sec-${key}`}>
          <div class="section-head"><h2 id={`sec-${key}`}>{CATEGORIES[key].name}</h2><a href={CATEGORIES[key].path}>More →</a></div>
          <ArticleList articles={items} showCategory={false} />
        </section>
      );
    })}
  </div>
</Base>
