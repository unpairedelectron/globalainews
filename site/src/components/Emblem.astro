---
// Animated line-art emblem per section. Pure SVG + CSS; static when the
// reader prefers reduced motion.
import type { CategoryKey } from '../site.config';
interface Props { kind: CategoryKey }
const { kind } = Astro.props;
---
<svg class={`emblem emblem-${kind}`} viewBox="0 0 200 200" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`eg-${kind}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--accent)" />
      <stop offset="1" stop-color="var(--violet)" />
    </linearGradient>
  </defs>
  <circle cx="100" cy="100" r="92" fill="var(--surface)" stroke="var(--line)" />
  <circle class="e-ring" cx="100" cy="100" r="80" fill="none" stroke={`url(#eg-${kind})`} stroke-width="1.5" stroke-dasharray="4 8" />
  {kind === 'models' && (
    <g fill="none" stroke={`url(#eg-${kind})`} stroke-width="2.5" stroke-linecap="round">
      <ellipse cx="100" cy="100" rx="56" ry="22" class="e-spin" />
      <ellipse cx="100" cy="100" rx="56" ry="22" transform="rotate(60 100 100)" class="e-spin e-d1" />
      <ellipse cx="100" cy="100" rx="56" ry="22" transform="rotate(120 100 100)" class="e-spin e-d2" />
      <circle cx="100" cy="100" r="9" fill="var(--accent)" stroke="none" class="e-pulse" />
    </g>
  )}
  {kind === 'policy' && (
    <g fill="none" stroke={`url(#eg-${kind})`} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <rect x="62" y="48" width="76" height="100" rx="8" />
      <path d="M76 72h48M76 88h48M76 104h30" class="e-draw" />
      <path d="M84 126l10 10 22-22" class="e-draw e-d2" stroke="var(--teal)" />
    </g>
  )}
  {kind === 'india' && (
    <g stroke={`url(#eg-${kind})`} stroke-width="2" fill="none">
      {[[70, 70], [130, 66], [100, 100], [64, 128], [136, 130], [100, 150], [100, 52]].map(([x, y], i) => (
        <circle cx={x} cy={y} r="6" fill={i === 2 ? 'var(--accent)' : 'var(--surface)'} class={`e-pulse e-d${i % 3}`} />
      ))}
      <path d="M70 70L100 100L130 66M100 100L64 128M100 100L136 130M100 100L100 150M100 100L100 52" class="e-draw" />
    </g>
  )}
  {kind === 'infrastructure' && (
    <g fill="none" stroke={`url(#eg-${kind})`} stroke-width="2.5" stroke-linecap="round">
      <rect x="68" y="68" width="64" height="64" rx="8" />
      <rect x="84" y="84" width="32" height="32" rx="4" fill="var(--accent-soft)" class="e-pulse" />
      <path d="M80 68V52M100 68V52M120 68V52M80 148v-16M100 148v-16M120 148v-16M68 80H52M68 100H52M68 120H52M148 80h-16M148 100h-16M148 120h-16" class="e-draw" />
    </g>
  )}
  {kind === 'safety' && (
    <g fill="none" stroke={`url(#eg-${kind})`} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M100 46l42 16v34c0 28-18 46-42 56-24-10-42-28-42-56V62z" />
      <path d="M100 82a12 12 0 0 1 12 12v8H88v-8a12 12 0 0 1 12-12z" class="e-draw" />
      <rect x="82" y="102" width="36" height="28" rx="5" fill="var(--accent-soft)" class="e-pulse" />
    </g>
  )}
  {kind === 'business' && (
    <g fill="none" stroke={`url(#eg-${kind})`} stroke-width="2.5" stroke-linecap="round">
      <path d="M56 146h92" />
      <rect x="64" y="112" width="16" height="34" rx="3" fill="var(--accent-soft)" class="e-grow" />
      <rect x="92" y="94" width="16" height="52" rx="3" fill="var(--accent-soft)" class="e-grow e-d1" />
      <rect x="120" y="70" width="16" height="76" rx="3" fill="var(--accent-soft)" class="e-grow e-d2" />
      <path d="M60 104l32-22 26 10 26-30" class="e-draw" stroke="var(--teal)" />
    </g>
  )}
  {kind === 'research' && (
    <g fill="none" stroke={`url(#eg-${kind})`} stroke-width="2.5" stroke-linecap="round">
      <circle cx="100" cy="72" r="12" fill="var(--accent-soft)" class="e-pulse" />
      <circle cx="68" cy="124" r="12" class="e-pulse e-d1" />
      <circle cx="132" cy="124" r="12" class="e-pulse e-d2" />
      <path d="M94 83L74 113M106 83l20 30M80 124h40" class="e-draw" />
    </g>
  )}
  {kind === 'guides' && (
    <g fill="none" stroke={`url(#eg-${kind})`} stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="100" cy="100" r="46" />
      <path d="M100 66l12 34-12 34-12-34z" fill="var(--accent-soft)" class="e-spin-slow" />
      <circle cx="100" cy="100" r="4" fill="var(--accent)" stroke="none" />
    </g>
  )}
</svg>

<style>
  .emblem .e-ring { transform-origin: 100px 100px; animation: e-rot 40s linear infinite; }
  .emblem .e-spin { transform-box: view-box; transform-origin: 100px 100px; animation: e-rot 18s linear infinite; }
  .emblem .e-spin-slow { transform-box: view-box; transform-origin: 100px 100px; animation: e-sway 6s ease-in-out infinite; }
  .emblem .e-pulse { animation: e-pulse 2.8s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .emblem .e-draw { stroke-dasharray: 300; stroke-dashoffset: 300; animation: e-draw 2.4s var(--ease) forwards; }
  .emblem .e-grow { transform-box: fill-box; transform-origin: bottom; animation: e-grow 1.6s var(--ease) both; }
  .emblem .e-d1 { animation-delay: .35s; }
  .emblem .e-d2 { animation-delay: .7s; }
  @keyframes e-rot { to { transform: rotate(360deg); } }
  @keyframes e-sway { 0%, 100% { transform: rotate(-14deg); } 50% { transform: rotate(14deg); } }
  @keyframes e-pulse { 0%, 100% { opacity: .65; transform: scale(.94); } 50% { opacity: 1; transform: scale(1.06); } }
  @keyframes e-draw { to { stroke-dashoffset: 0; } }
  @keyframes e-grow { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) { .emblem .e-draw { stroke-dashoffset: 0; } }
</style>
