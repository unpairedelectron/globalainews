---
import { articlePath, category, formatDate, readingTime, type Article } from '../lib/articles';
import AdSlot from './AdSlot.astro';

interface Props { articles: Article[]; showCategory?: boolean; level?: 2 | 3; adAfter?: number }
const { articles, showCategory = true, level = 3, adAfter } = Astro.props;
const H = `h${level}`;
---
<ul class="list">
  {articles.map((a, i) => (
    <>
    {adAfter && i === adAfter && <li class="ad-li"><AdSlot place="list" /></li>}
    <li>
      {showCategory && <a class="kicker" href={category(a).path}>{category(a).name}</a>}
      <H><a href={articlePath(a)}>{a.data.title}</a></H>
      <p>{a.data.description}</p>
      <p class="meta"><time data-fresh datetime={a.data.date.toISOString()}>{formatDate(a.data.date)}</time> · {readingTime(a)} min read</p>
    </li>
    </>
  ))}
</ul>
