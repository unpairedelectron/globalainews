---
import { articlePath, category, formatDate, readingTime, type Article } from '../lib/articles';

interface Props { articles: Article[]; showCategory?: boolean }
const { articles, showCategory = true } = Astro.props;
---
<ul class="list">
  {articles.map((a) => (
    <li>
      {showCategory && <a class="kicker" href={category(a).path}>{category(a).name}</a>}
      <h3><a href={articlePath(a)}>{a.data.title}</a></h3>
      <p>{a.data.description}</p>
      <p class="meta"><time datetime={a.data.date.toISOString()}>{formatDate(a.data.date)}</time> · {readingTime(a)} min read</p>
    </li>
  ))}
</ul>
