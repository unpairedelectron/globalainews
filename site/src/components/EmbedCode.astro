---
// "Embed this chart" box with copy-to-clipboard. The snippet includes a
// visible credit link (iframe content links don't pass as backlinks).
import { SITE } from '../site.config';
interface Props { embed: string; tracker: string; title: string; height: number }
const { embed, tracker, title, height } = Astro.props;
const code = `<iframe src="${SITE.url}${embed}" title="${title}" width="100%" height="${height}" style="border:0;max-width:760px" loading="lazy"></iframe>\n<p>Source: <a href="${SITE.url}${tracker}">${title} — ${SITE.name}</a></p>`;
---
<details class="embed-code">
  <summary>Embed this chart on your site</summary>
  <p class="meta">Free to embed with the credit link included. The chart updates automatically when we update the tracker.</p>
  <pre><code>{code}</code></pre>
  <button type="button" class="btn ghost" data-copy={code}>Copy embed code</button>
</details>

<style is:global>
  .embed-code { margin: 0 0 24px; padding: 12px 16px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--surface); }
  .embed-code summary { cursor: pointer; font-weight: 600; font-size: 15px; }
  .embed-code pre { white-space: pre-wrap; word-break: break-all; font-size: 12.5px; background: var(--bg-2); padding: 10px 12px; border-radius: 8px; }
  .embed-code button { font-family: inherit; cursor: pointer; }
</style>

<script>
document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
  try { await navigator.clipboard.writeText(b.dataset.copy ?? ''); b.textContent = 'Copied ✓'; }
  catch { b.textContent = 'Select the code above and copy it'; }
  setTimeout(() => (b.textContent = 'Copy embed code'), 2500);
}));
</script>
