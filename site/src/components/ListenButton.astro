---
// "Listen to this article" using the browser's built-in speech synthesis.
// Hidden when the browser has no speech support. Reads the headline, standfirst
// and body, skipping sources, methodology and charts' data tables.
---
<div class="listen" hidden>
  <button type="button" class="listen-btn" data-state="idle" aria-label="Listen to this article">
    <svg class="i-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 5l12 7-12 7z" fill="currentColor"/></svg>
    <svg class="i-pause" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" fill="currentColor"/></svg>
    <span class="listen-label">Listen</span>
    <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
  </button>
  <button type="button" class="listen-stop" aria-label="Stop listening" hidden>Stop</button>
</div>

<style is:global>
  .listen { display: inline-flex; gap: 6px; align-items: center; }
  .listen-btn, .listen-stop { display: inline-flex; align-items: center; gap: 7px; padding: 5px 13px; border-radius: 999px; border: 1px solid var(--line-2); background: var(--surface); color: var(--ink); font: inherit; font-size: 13.5px; font-weight: 600; cursor: pointer; transition: border-color .2s, color .2s; }
  .listen-btn:hover, .listen-stop:hover { border-color: var(--accent); color: var(--accent); }
  .listen-btn .i-pause, .listen-btn .bars { display: none; }
  .listen-btn[data-state='playing'] .i-play { display: none; }
  .listen-btn[data-state='playing'] .i-pause, .listen-btn[data-state='playing'] .bars { display: inline-flex; }
  .bars { gap: 2px; align-items: end; height: 12px; }
  .bars i { width: 3px; background: var(--accent); border-radius: 2px; animation: eq 1s ease-in-out infinite; }
  .bars i:nth-child(2) { animation-delay: .2s; } .bars i:nth-child(3) { animation-delay: .4s; }
  @keyframes eq { 0%, 100% { height: 4px; } 50% { height: 12px; } }
</style>

<script>
const wrap = document.querySelector<HTMLElement>('.listen');
const btn = wrap?.querySelector<HTMLButtonElement>('.listen-btn');
const stopBtn = wrap?.querySelector<HTMLButtonElement>('.listen-stop');
const label = wrap?.querySelector<HTMLElement>('.listen-label');
const synth = window.speechSynthesis;

if (wrap && btn && stopBtn && label && synth && 'SpeechSynthesisUtterance' in window) {
  wrap.hidden = false;
  let chunks: string[] = [];
  let i = 0;
  let state: 'idle' | 'playing' | 'paused' = 'idle';

  const collect = () => {
    const parts: string[] = [];
    const h1 = document.querySelector('.article h1')?.textContent;
    const dek = document.querySelector('.article .dek')?.textContent;
    if (h1) parts.push(h1);
    if (dek) parts.push(dek);
    const prose = document.querySelector('.article .prose');
    if (prose) {
      for (const el of Array.from(prose.children)) {
        if (el.tagName === 'H2' && /^(sources|methodology note|corrections log)$/i.test(el.textContent?.trim() ?? '')) break;
        if (/^(H2|H3|P|UL|OL|BLOCKQUOTE)$/.test(el.tagName)) {
          const t = (el.textContent ?? '').replace(/\[\d+(?:[–-]\d+)?\]/g, '').replace(/\s+/g, ' ').trim();
          if (t) parts.push(t);
        }
      }
    }
    // Short chunks avoid the Chrome cut-off on long utterances.
    return parts.join('. ').match(/[^.!?]+[.!?]+|[^.!?]+$/g)?.map((s) => s.trim()).filter(Boolean) ?? [];
  };
  const voice = () => {
    const vs = synth.getVoices();
    return vs.find((v) => v.lang === 'en-IN') ?? vs.find((v) => v.lang === 'en-GB') ?? vs.find((v) => v.lang.startsWith('en'));
  };
  const set = (s: typeof state) => {
    state = s; btn.dataset.state = s === 'playing' ? 'playing' : 'idle';
    label.textContent = s === 'playing' ? 'Pause' : s === 'paused' ? 'Resume' : 'Listen';
    stopBtn.hidden = s === 'idle';
  };
  const speakNext = () => {
    if (state !== 'playing') return;
    if (i >= chunks.length) { set('idle'); i = 0; return; }
    const u = new SpeechSynthesisUtterance(chunks[i]);
    const v = voice(); if (v) { u.voice = v; u.lang = v.lang; }
    u.rate = 1.02;
    u.onend = () => { i++; speakNext(); };
    u.onerror = () => { i++; speakNext(); };
    synth.speak(u);
  };
  btn.addEventListener('click', () => {
    if (state === 'idle') { chunks = collect(); i = 0; synth.cancel(); set('playing'); speakNext(); }
    else if (state === 'playing') { synth.pause(); set('paused'); }
    else { synth.resume(); set('playing'); }
  });
  stopBtn.addEventListener('click', () => { synth.cancel(); i = 0; set('idle'); });
  addEventListener('pagehide', () => synth.cancel());
}
</script>
