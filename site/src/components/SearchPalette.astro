---
// Command-palette search (Ctrl/Cmd+K or "/"). The index loads on first open.
---
<button class="search-btn" type="button" data-search-open aria-label="Search the site">
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  <span>Search</span><kbd>Ctrl K</kbd>
</button>

<dialog class="palette" aria-label="Search">
  <div class="palette-box">
    <div class="palette-input">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="M20 20l-4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <input type="search" placeholder="Search articles, AI terms, trackers…" aria-label="Search" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="palette-results" />
      <kbd>Esc</kbd>
    </div>
    <ul id="palette-results" class="palette-results" role="listbox"></ul>
    <p class="palette-foot"><span><kbd>↑</kbd><kbd>↓</kbd> navigate</span><span><kbd>Enter</kbd> open</span><span>Try “token”, “IndiaAI”, “EU AI Act”</span></p>
  </div>
</dialog>

<style is:global>
  .search-btn { display: inline-flex; align-items: center; gap: 8px; padding: 7px 10px 7px 12px; border-radius: 999px; border: 1px solid var(--line-2); background: var(--surface); color: var(--muted); font: inherit; font-size: 14px; cursor: pointer; transition: border-color .2s, color .2s, box-shadow .2s; }
  .search-btn:hover { border-color: var(--accent); color: var(--accent); box-shadow: var(--shadow-1); }
  .search-btn kbd { display: none; }
  @media (min-width: 720px) { .search-btn kbd { display: inline-block; } }
  kbd { font-family: var(--mono); font-size: 11px; padding: 1px 6px; border: 1px solid var(--line-2); border-bottom-width: 2px; border-radius: 6px; background: var(--bg-2); color: var(--muted); }
  .palette { width: min(680px, calc(100vw - 24px)); max-height: min(70vh, 640px); margin: 10vh auto auto; padding: 0; border: 1px solid var(--line-2); border-radius: 18px; background: var(--surface); color: var(--ink); box-shadow: 0 30px 80px rgba(14, 23, 38, 0.25); overflow: hidden; }
  .palette::backdrop { background: rgba(14, 23, 38, 0.32); backdrop-filter: blur(4px); }
  .palette[open] { animation: pal-in .22s var(--ease); }
  @keyframes pal-in { from { opacity: 0; transform: translateY(-8px) scale(.98); } }
  .palette-box { display: flex; flex-direction: column; max-height: inherit; }
  .palette-input { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--line); color: var(--muted); }
  .palette-input input { flex: 1; border: 0; outline: 0; background: transparent; color: var(--ink); font: inherit; font-size: 18px; }
  .palette-results { list-style: none; margin: 0; padding: 8px; overflow-y: auto; }
  .palette-results li a { display: grid; grid-template-columns: auto 1fr; gap: 2px 12px; padding: 10px 12px; border-radius: 12px; color: var(--ink); text-decoration: none; }
  .palette-results li a[aria-selected='true'] { background: var(--accent-soft); }
  .palette-results .k { grid-row: span 2; align-self: start; margin-top: 2px; font-family: var(--mono); font-size: 10.5px; letter-spacing: .05em; text-transform: uppercase; padding: 2px 7px; border-radius: 6px; background: var(--bg-2); color: var(--accent); border: 1px solid var(--line); }
  .palette-results .t { font-weight: 600; line-height: 1.35; }
  .palette-results .d { font-size: 13.5px; color: var(--muted); line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .palette-results mark { background: rgba(42, 120, 214, 0.16); color: inherit; border-radius: 3px; }
  .palette-results .empty { padding: 18px 12px; color: var(--muted); }
  .palette-foot { display: flex; flex-wrap: wrap; gap: 14px; margin: 0; padding: 10px 16px; border-top: 1px solid var(--line); font-size: 12.5px; color: var(--muted); }
  .palette-foot kbd { margin-right: 3px; }
</style>

<script>
type Item = { t: string; d: string; u: string; k: string; c: string; g: string };
const dlg = document.querySelector<HTMLDialogElement>('dialog.palette');
const input = dlg?.querySelector<HTMLInputElement>('input');
const list = dlg?.querySelector<HTMLUListElement>('.palette-results');
let index: Item[] | null = null;
let sel = 0;
let results: Item[] = [];

const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '');
const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
const highlight = (text: string, terms: string[]) => {
  let out = esc(text);
  for (const t of terms) if (t.length > 1) out = out.replace(new RegExp(`(^|[^\\p{L}\\p{N}])(${t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'igu'), '$1<mark>$2</mark>');
  return out;
};

async function load() {
  if (index) return index;
  try { index = await (await fetch('/search.json')).json(); } catch { index = []; }
  return index!;
}

function search(q: string): Item[] {
  const terms = norm(q).split(/\s+/).filter(Boolean);
  if (!index) return [];
  if (!terms.length) return index.filter((i) => i.k !== 'Glossary').slice(0, 8);
  const scored: [number, Item][] = [];
  for (const it of index) {
    const t = norm(it.t), d = norm(it.d), x = norm(`${it.c} ${it.g} ${it.k}`);
    let s = 0, ok = true;
    for (const term of terms) {
      const ts = t.includes(term) ? (t.startsWith(term) || t.includes(` ${term}`) ? 6 : 4) : 0;
      const ds = d.includes(term) ? 1.5 : 0, xs = x.includes(term) ? 2 : 0;
      if (!ts && !ds && !xs) { ok = false; break; }
      s += ts + ds + xs;
    }
    if (ok) scored.push([s + (it.k === 'Glossary' && t === terms.join(' ') ? 10 : 0), it]);
  }
  return scored.sort((a, b) => b[0] - a[0]).slice(0, 12).map(([, it]) => it);
}

function render() {
  if (!list || !input) return;
  const terms = norm(input.value).split(/\s+/).filter(Boolean);
  if (!results.length) { list.innerHTML = `<li class="empty">No results for “${esc(input.value)}”. Try a company, a term or a topic.</li>`; return; }
  list.innerHTML = results.map((r, i) => `<li role="option"><a href="${esc(r.u)}" aria-selected="${i === sel}"><span class="k">${esc(r.k)}</span><span class="t">${highlight(r.t, terms)}</span><span class="d">${highlight(r.d, terms)}</span></a></li>`).join('');
  list.querySelector('[aria-selected="true"]')?.scrollIntoView({ block: 'nearest' });
}

async function open() {
  if (!dlg || !input) return;
  if (!dlg.open) dlg.showModal();
  input.value = ''; sel = 0;
  await load();
  results = search(''); render();
  input.focus();
}

document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
addEventListener('keydown', (e) => {
  const tag = (e.target as HTMLElement)?.tagName;
  if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !/INPUT|TEXTAREA/.test(tag))) { e.preventDefault(); open(); }
});
input?.addEventListener('input', () => { sel = 0; results = search(input.value); render(); });
input?.addEventListener('keydown', (e) => {
  if (e.key === 'ArrowDown') { e.preventDefault(); sel = Math.min(results.length - 1, sel + 1); render(); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); sel = Math.max(0, sel - 1); render(); }
  else if (e.key === 'Enter' && results[sel]) { e.preventDefault(); location.href = results[sel].u; dlg?.close(); }
});
dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
