---
// Strategic ad placements. Rules that protect reading:
// - never above the headline, inside takeaways/charts/tables, or next to
//   share/listen buttons (accidental clicks are against AdSense policy);
// - space is reserved before the ad loads, so text never jumps (CLS 0);
// - ads load only when the reader scrolls near them (lazy, better viewability);
// - a placement renders nothing until its unit ID is set in site.config.ts.
import { ADS } from '../site.config';
type Place = 'mid' | 'mid2' | 'end' | 'rail' | 'home' | 'list';
interface Props { place: Place }
const { place } = Astro.props;
const unit = ADS.units[place === 'mid2' ? 'mid' : place];
const active = /^\d+$/.test(unit);
const inArticle = place === 'mid' || place === 'mid2';
---
{active && (
  <aside class={`ad ad-${place}`} aria-label="Advertisement" data-ad-place={place}>
    <p class="ad-label">Advertisement</p>
    {inArticle
      ? <ins class="adsbygoogle" style="display:block; text-align:center;" data-ad-client={ADS.client} data-ad-slot={unit} data-ad-layout="in-article" data-ad-format="fluid"></ins>
      : place === 'rail'
        ? <ins class="adsbygoogle" style="display:inline-block;width:300px;height:600px" data-ad-client={ADS.client} data-ad-slot={unit}></ins>
        : <ins class="adsbygoogle" style="display:block" data-ad-client={ADS.client} data-ad-slot={unit} data-ad-format="auto" data-full-width-responsive="true"></ins>}
  </aside>
)}
