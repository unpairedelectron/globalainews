---
// Manual AdSense unit. Renders nothing until a numeric slot ID is set in
// site.config.ts, so no empty boxes or layout shift appear before then.
import { ADS } from '../site.config';
interface Props { slot: keyof typeof ADS.slots }
const id = ADS.slots[Astro.props.slot];
---
{/^\d+$/.test(id) && (
  <aside class="ad" aria-label="Advertisement">
    <p class="ad-label">Advertisement</p>
    <ins class="adsbygoogle" style="display:block" data-ad-client={ADS.client} data-ad-slot={id} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
