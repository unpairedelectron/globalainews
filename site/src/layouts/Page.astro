---
import Base from './Base.astro';
import { SITE } from '../site.config';
interface Props { title: string; heading?: string; description: string; path: string; updated?: string; noindex?: boolean; ads?: boolean; jsonLd?: object[] }
const { title, heading, description, path, updated, noindex = false, ads = false, jsonLd = [] } = Astro.props;
---
<Base title={`${title} | ${SITE.name}`} description={description} path={path} noindex={noindex} ads={ads} jsonLd={jsonLd}>
  <div class="wrap">
    <article class="page">
      <h1>{heading ?? title}</h1>
      {updated && <p class="meta">Last updated: {updated}</p>}
      <div class="prose"><slot /></div>
    </article>
  </div>
</Base>
