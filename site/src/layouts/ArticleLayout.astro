---
import Base from './Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AdSlot from '../components/AdSlot.astro';
import Share from '../components/Share.astro';
import ListenButton from '../components/ListenButton.astro';
import Newsletter from '../components/Newsletter.astro';
import { render } from 'astro:content';
import { SITE } from '../site.config';
import { PEOPLE, personByName } from '../data/people';
import {
  absolute, articlePath, category, formatIST, isoIST, lastModified, ogImage, readingTime, related, sourceUrls, wordCount,
  type Article,
} from '../lib/articles';

interface Props { article: Article; all: Article[] }
const { article, all } = Astro.props;
const d = article.data;
const { Content, headings } = await render(article);
const path = articlePath(article);
const cat = category(article);
const modified = lastModified(article);
const toc = headings.filter((h) => h.depth === 2 && !/^(Sources|Methodology note|FAQ)$/i.test(h.text));
const more = related(article, all, 3);
const isGuide = d.type === 'guide';
const author = d.author ? PEOPLE[d.author] : undefined;
const reviewer = personByName(d.reviewer);
const citations = sourceUrls(article);
const personLd = (p: NonNullable<typeof author>) => ({ '@type': 'Person', name: p.name, jobTitle: p.jobTitle, url: absolute(`/authors/${p.slug}/`) });
const baseTitle = d.seoTitle ?? d.title;
const pageTitle = baseTitle.length + SITE.name.length + 3 <= 65 ? `${baseTitle} | ${SITE.name}` : baseTitle;

const jsonLd = [
  {
    '@type': isGuide ? 'Article' : 'NewsArticle',
    '@id': `${absolute(path)}#article`,
    mainEntityOfPage: absolute(path),
    headline: d.title.length > 110 ? (d.seoTitle ?? d.title.slice(0, 110)) : d.title,
    description: d.description,
    image: [absolute(ogImage(article)), ...(d.image ? [absolute(d.image)] : [])],
    datePublished: isoIST(d.date),
    dateModified: isoIST(modified),
    articleSection: cat.name,
    keywords: d.tags.join(', '),
    wordCount: wordCount(article),
    inLanguage: SITE.lang,
    isAccessibleForFree: true,
    author: author ? personLd(author) : { '@type': 'Organization', name: SITE.desk, url: `${SITE.url}/about-us/` },
    ...(reviewer ? { reviewedBy: personLd(reviewer) } : {}),
    ...(citations.length ? { citation: citations } : {}),
    publisher: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: cat.name, item: absolute(cat.path) },
      { '@type': 'ListItem', position: 3, name: d.seoTitle ?? d.title, item: absolute(path) },
    ],
  },
];
---
<Base
  title={pageTitle}
  description={d.description}
  path={path}
  image={ogImage(article)}
  imageAlt={d.imageAlt ?? d.title}
  type="article"
  published={d.date}
  modified={modified}
  section={cat.name}
  tags={d.tags}
  jsonLd={jsonLd}
>
  <div class="wrap">
    <div class="article-shell">
    {toc.length >= 4 && (
      <nav class="toc-float" aria-label="In this article">
        <p class="eyebrow">In this article</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ol>
      </nav>
    )}
    <article class="article">
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href={cat.path}>{cat.name}</a></li>
        </ol>
      </nav>
      <h1>{d.title}</h1>
      <p class="dek">{d.description}</p>
      <div class="byline">
        <span>By <strong>{author ? <a href={`/authors/${author.slug}/`} style="color:inherit">{author.name}</a> : <a href="/about-us/" style="color:inherit">{SITE.desk}</a>}</strong></span>
        {reviewer ? <span>Reviewed by <strong><a href={`/authors/${reviewer.slug}/`} style="color:inherit">{reviewer.name}</a></strong>, {reviewer.jobTitle}</span> : d.reviewer && <span>Reviewed by <strong>{d.reviewer}</strong></span>}
        <span>Published <time datetime={isoIST(d.date)}>{formatIST(d.date)}</time></span>
        {modified > d.date && <span>Updated <time datetime={isoIST(modified)}>{formatIST(modified)}</time></span>}
        <span>{readingTime(article)} min read</span>
      </div>

      <div class="article-tools">
        <ListenButton />
        <Share url={absolute(path)} title={d.title} />
      </div>

      {d.image && !d.image.endsWith('/hero.jpg') && (
        <figure class="hero">
          <img src={d.image} alt={d.imageAlt ?? ''} width="1200" height="675" fetchpriority="high" decoding="async" />
        </figure>
      )}

      <section class="takeaways" aria-labelledby="takeaways-h">
        <h2 id="takeaways-h">Key takeaways</h2>
        <ul>{d.takeaways.map((t) => <li>{t}</li>)}</ul>
      </section>

      {toc.length >= 4 && (
        <details class="toc">
          <summary>In this article</summary>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </details>
      )}

      <AdSlot slot="inArticle" />

      <div class="prose">
        <Content />
      </div>

      {d.tags.length > 0 && <ul class="tags" aria-label="Topics">{d.tags.map((t) => <li>{t}</li>)}</ul>}

      <Share url={absolute(path)} title={d.title} label="Share this article (end of article)" />

      {[author, reviewer].filter((p, i, arr) => p && arr.indexOf(p) === i).map((p) => p && (
        <div class="about-box person-box">
          <img src={p.image ?? '/logo.svg'} alt="" width="44" height="44" />
          <p><strong><a href={`/authors/${p.slug}/`}>{p.name}</a>, {p.jobTitle}{p === reviewer && p !== author ? ' (reviewer)' : ''}.</strong> {p.bio[0]}</p>
        </div>
      ))}

      <div class="about-box">
        <img src="/logo.svg" alt="" width="44" height="44" />
        <p><strong>{SITE.desk}</strong> explains AI news using primary sources: filings, official documents, papers and company announcements. Claims made by companies are attributed to them. Spotted an error? <a href="/contact-us/">Tell us</a> — we correct mistakes openly under our <a href="/editorial-policy/">editorial policy</a>.</p>
      </div>

      <Newsletter />

      <AdSlot slot="afterArticle" />
    </article>
    </div>

    {more.length > 0 && (
      <section class="related" aria-labelledby="related-h">
        <h2 id="related-h">Read next</h2>
        <div class="grid grid-3">{more.map((a) => <ArticleCard article={a} />)}</div>
      </section>
    )}
  </div>
</Base>
