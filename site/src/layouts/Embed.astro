---
// Minimal frame for embeddable charts: no header, footer, ads or analytics.
// noindex, with the canonical pointing at the full tracker page.
import '../styles/global.css';
import { SITE } from '../site.config';
interface Props { title: string; tracker: string; trackerName: string }
const { title, tracker, trackerName } = Astro.props;
const canonical = new URL(tracker, SITE.url).toString();
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {SITE.name}</title>
    <meta name="description" content={`Embeddable chart: ${title}. From the ${trackerName} by ${SITE.name}.`} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body class="embed">
    <main>
      <h1 class="skip">{title}</h1>
      <slot />
    </main>
    <footer class="embed-credit">Source: <a href={canonical} target="_blank" rel="noopener">{SITE.name} · {trackerName}</a></footer>
    <script>import '../scripts/motion.ts';</script>
  </body>
</html>

<style is:global>
  body.embed { background: var(--surface); padding: 8px; margin: 0; }
  body.embed .viz { margin: 0; box-shadow: none; }
  .embed-credit { margin: 8px 4px 0; font-size: 12.5px; color: var(--muted); }
</style>
